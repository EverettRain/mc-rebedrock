#pragma once

// Generated by CMake (configure_file from core/BuildInfo.hpp.in) — do not edit
// the generated copy. The build metadata is baked in at configure time from the
// git commit, NOT the wall clock: two configures of the same commit produce the
// same kBuildTime and kBuildRef, so a build's identity is a function of its
// source, not of when it happened. That determinism is the whole point (see
// content-dev/META-metadata/REGULAR.md §3) — a metadata field that changed every
// run could not tell two builds apart, only two runs of one build.

#include <string_view>

namespace mc::core {

// The commit's author date in ISO 8601, or "unknown" outside a git checkout.
inline constexpr std::string_view kBuildTime = "@MC_REBEDROCK_BUILD_TIME@";

// The short commit hash the build was configured from, or "unknown".
inline constexpr std::string_view kBuildRef = "@MC_REBEDROCK_BUILD_REF@";

} // namespace mc::core
